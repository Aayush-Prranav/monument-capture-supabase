# Copy to mobile/.env and adjust. .env is git-ignored.

# Which backend: "local" (everything in the browser, demo accounts) or
# "supabase" (real accounts; game data moves over stage by stage).
EXPO_PUBLIC_BACKEND=supabase

# The MN Capture Supabase project. Both values are public by design: the
# publishable key only gets what the database's row-level security allows.
# NEVER put the secret key (sb_secret_...) or the database password here.
EXPO_PUBLIC_SUPABASE_URL=https://jqxffydjcjkqftifijcp.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_d3sr609cxJGUegq89qsBLA_oB1ueNyr

# Demo tools (fake location, fast-forward clock, reset) in Supabase mode.
# Always on in local mode. Leave false for anything you deploy publicly.
EXPO_PUBLIC_DEV_TOOLS=false

# Optional: free CARTO basemaps key for the Voyager map style (https://carto.com/basemaps/apikey/).
# Without it the map uses OpenStreetMap tiles.
EXPO_PUBLIC_CARTO_API_KEY=
